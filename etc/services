# Services started by init, in dependency order.
#
# One stanza per service, separated by blank lines. Keys are the field names of
# `Service` in src/user/init.zig, so this file and the parser cannot drift.
#
#   name      what other services call this one in `needs`
#   binary    absolute path to the program
#   needs     comma-separated services that must be up first
#   provides  the /svc name it registers, if any; init waits for it to appear
#   restart   never | on_failure | always
#   caps      comma-separated capabilities, from `Caps` in the syscall ABI.
#             Empty keeps everything init has. Capabilities are intersected at
#             every spawn, so what is listed here bounds the whole tree below
#             the service, not just the service itself.

name    = devmgd
binary  = /bin/devmgd
# Everything a device manager grants, so it can pass a subset to each driver.
# It is the only thing in the tree with `driver`, which is what stops anything
# else from reaching hardware.
caps    = spawn,driver
restart = never

name    = cfgd
binary  = /bin/cfgd
# The settings store. Nothing else may write /etc, which is what makes two
# programs saving at once safe.
provides = cfg
restart = always

name    = vsh
binary  = /bin/vsh
restart = always
# Everything a session needs and nothing a driver needs: the shell, the
# desktop and every program either of them starts are all below this line, so
# none of them can take an interrupt line or map a device.
caps    = spawn,kill,power,display
