#
# High Definition Audio, by class rather than by part number: the
# register interface is the specification's and not a maker's, so one
# driver covers Intel, ATI, nVidia and VIA alike. The part named beside
# it is the one verified on the target, with its ALC662 codec.
name    = hda
service = audio
match   = pci:8086:2668, pci-class:04:03
