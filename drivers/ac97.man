# Generated from src/lib/driver.zig by `zig build driver-manifests`.
# Do not edit: change what the driver answers for instead.
#
# AC'97 on the Intel controller line, by part number and not by class:
# subclass 01 is every audio device that is not HDA, and most of them
# answer nothing like this. So the controller of each chipset generation
# that carried AC'97 is named, the first of them being what an emulator
# gives a machine.
name    = ac97
service = audio
match   = pci:8086:2415|2425|2445|2485|24c5|24d5|266e|27de|7195
