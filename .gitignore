# Build outputs
build/
zig-out/
.zig-cache/

# What is staged for the machine's home directory: built apps and the
# data they work on. The recipes are tracked; what they produce is not,
# and neither is anything somebody put there by hand.
home/*
!home/.gitkeep

# Editor / OS noise
.DS_Store
*.swp

# The design canvas: working files and the seeded page the editor is baked
# into, which is megabytes of generated payload. The published canvas is the
# record; what it decided is written down beside the code it describes.
.design/

# Python's own cache, from the fixture generator.
__pycache__/
